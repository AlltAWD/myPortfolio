---
import { getEntry } from 'astro:content';
import { BookOpen, Code, Search, ArrowRight, Clock } from 'lucide-solid';

const lang = Astro.currentLocale || 'en-US';
let statusEntry = await getEntry('status', `${lang}/index`);
if (!statusEntry && lang !== 'en-US') {
  statusEntry = await getEntry('status', `en-US/index`);
}
const status = statusEntry?.data || { learning: [], building: [], research: [] };

const statusUrl = lang === 'en-US' ? '/status' : `/${lang}/status`;

function timeAgo(dateString: string) {
  if (!dateString) return 'recently';
  const diffDays = Math.ceil(
    Math.abs(Date.now() - new Date(dateString).getTime()) / 86400000
  );
  if (diffDays === 0) return 'today';
  if (diffDays === 1) return 'yesterday';
  if (diffDays < 7) return `${diffDays} days ago`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)} months ago`;
  return `${Math.floor(diffDays / 365)} years ago`;
}

// Only the first two entries per column fit the summary card.
const learning = status.learning.slice(0, 2);
const building = status.building.slice(0, 2);
const research = status.research.slice(0, 2);
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <!-- Learning -->
  <a href={`${statusUrl}#learning`} class="neu-flat p-6 rounded-2xl hover:scale-[1.02] transition-transform block reveal">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 neu-pressed rounded-lg text-blue-500">
          <BookOpen class="w-6 h-6" />
        </div>
        <h2 class="text-xl font-bold">Learning</h2>
      </div>
      <ArrowRight class="w-4 h-4 text-[var(--muted-foreground)]" />
    </div>

    <div class="space-y-6">
      {learning.length === 0 && (
        <p class="text-xs text-[var(--muted-foreground)]">Nothing active right now.</p>
      )}
      {learning.map((item) => (
        <div>
          <div class="flex justify-between text-sm mb-2">
            <span class="font-medium">{item.title}</span>
            <span class="text-[var(--muted-foreground)]">{item.progress}%</span>
          </div>
          <div class="h-2 bg-[var(--muted)] rounded-full overflow-hidden">
            <div class="h-full bg-blue-500 rounded-full" style={`width: ${item.progress}%`}></div>
          </div>
          <p class="text-xs text-[var(--muted-foreground)] mt-2 line-clamp-2">{item.description}</p>
          <div class="flex items-center gap-1 mt-2 text-[10px] text-[var(--muted-foreground)] opacity-70">
            <Clock class="w-3 h-3" />
            <span>Updated {timeAgo(item.lastUpdated)}</span>
          </div>
        </div>
      ))}
    </div>
  </a>

  <!-- Building -->
  <a href={`${statusUrl}#building`} class="neu-flat p-6 rounded-2xl hover:scale-[1.02] transition-transform block reveal">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 neu-pressed rounded-lg text-emerald-500">
          <Code class="w-6 h-6" />
        </div>
        <h2 class="text-xl font-bold">Building</h2>
      </div>
      <ArrowRight class="w-4 h-4 text-[var(--muted-foreground)]" />
    </div>

    <div class="space-y-6">
      {building.length === 0 && (
        <p class="text-xs text-[var(--muted-foreground)]">Nothing active right now.</p>
      )}
      {building.map((item) => (
        <div>
          <div class="flex justify-between text-sm mb-2">
            <span class="font-medium">{item.title}</span>
            <span class={`font-bold text-xs ${item.progress >= 50 ? 'text-emerald-500' : 'text-yellow-500'}`}>
              {item.progress}%
            </span>
          </div>
          <div class="h-2 bg-[var(--muted)] rounded-full overflow-hidden">
            <div
              class={`h-full rounded-full ${item.progress >= 50 ? 'bg-emerald-500' : 'bg-yellow-500'}`}
              style={`width: ${item.progress}%`}
            ></div>
          </div>
          {item.tasks.length > 0 && (
            <p class="text-xs text-[var(--muted-foreground)] mt-2 line-clamp-2">
              {item.tasks[item.tasks.length - 1]}
            </p>
          )}
          <div class="flex items-center gap-1 mt-2 text-[10px] text-[var(--muted-foreground)] opacity-70">
            <Clock class="w-3 h-3" />
            <span>Updated {timeAgo(item.lastUpdated)}</span>
          </div>
        </div>
      ))}
    </div>
  </a>

  <!-- Research -->
  <a href={`${statusUrl}#research`} class="neu-flat p-6 rounded-2xl hover:scale-[1.02] transition-transform block reveal">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 neu-pressed rounded-lg text-purple-500">
          <Search class="w-6 h-6" />
        </div>
        <h2 class="text-xl font-bold">Research</h2>
      </div>
      <ArrowRight class="w-4 h-4 text-[var(--muted-foreground)]" />
    </div>

    <div class="space-y-4">
      {research.length === 0 && (
        <p class="text-xs text-[var(--muted-foreground)]">Nothing active right now.</p>
      )}
      {research.map((item, i) => (
        <div class={`neu-pressed p-3 rounded-xl ${i > 0 ? 'opacity-70' : ''}`}>
          <div class="flex justify-between items-center mb-1 gap-2">
            <span class="font-bold text-sm">{item.title}</span>
            <span class="text-[10px] shrink-0 px-2 py-0.5 bg-purple-500/10 text-purple-500 rounded-full border border-purple-500/20">
              {item.phase}
            </span>
          </div>
          <p class="text-xs text-[var(--muted-foreground)] line-clamp-2">{item.description}</p>
          <div class="flex items-center gap-1 mt-2 text-[10px] text-[var(--muted-foreground)] opacity-70">
            <Clock class="w-3 h-3" />
            <span>Updated {timeAgo(item.lastUpdated)}</span>
          </div>
        </div>
      ))}
    </div>
  </a>
</div>
